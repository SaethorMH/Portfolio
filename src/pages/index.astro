---
import MainLayout  from "../Components/MainLayout.astro";
---


<MainLayout title="Frontpage" headerTheme="red" footerTheme="red">
	
	<main>
	<section id="hero">
		<img src="/images/profilePicture.webp" alt="Image of Me, Sæþór">
		<h1><span>Sæþór M.</span><span>Hjálmarsson</span> </h1>
		<div><p>Frontend</p></div>
		<div><p>Digital Media</p></div>	
		<div><p>UX/UI</p></div>
		<div><p>Frontend</p></div>
		<div><p>Frontend</p></div>
		<div></div>
	</section>
	<section id="intro">

	</section>
	<section id="skills">

	</section>
	<section id="teasers">

	</section>
	</main>


</MainLayout>

<style>
h1{
	display: grid;
	gap: 0.2rem;
	background-color: var(--blue);
	grid-template-columns: subgrid;
	grid-template-rows: 1fr 1fr;
	
	font-size: 3.5rem;
	
}
h1 span{
	grid-column: span 2;
	background-color: var(--bgColor)
}
h1 span:last-child{
	grid-row:2 / 3;
	grid-column: 2/ -1;
	
}
main{
	width: 80%;
	place-self: center;
	border: solid var(--blue) 0.2rem;
	}


section{
	display: grid;
	max-height: 95vh;
	background-color: var(--blue);
	gap: 0.2rem;
	div{
		background-color: var(--bgColor);
	}
}

#hero{
	grid-template-columns: repeat(6, 1fr);
	grid-template-rows: 1fr 1fr 1fr;
	text-align: center;
	vertical-align: middle;
		

}
#hero img{
	grid-column: span 3;
	grid-row: span 3;
	object-fit: contain;
}
#hero h1{
	grid-column: span 3;
}
#hero h2{
	grid-column: span 2;
}
#hero div{
	aspect-ratio: 1;
	display: flex;
	place-items: center;
	transition: all 0.7s ease;
}
#hero div p{
	width: 100%;
	display: block;
	text-align: center;
	font-size: 2rem;
		transition: all 0.7s ease;

}
#hero div:nth-child(even){
	border-radius: 0 100% 0 100%;
	p{
		transform: rotate(45deg);
	}
}#hero div:nth-child(odd){
	border-radius: 100% 0 100% 0;
	p{
		transform: rotate(-45deg);
	}
}
#hero div:last-child{
	border-radius: 100%;
}
#hero div:hover {
	border-radius: 0%;
	
	p{
		transform: rotate(0deg);
		margin-top: -5rem;
	}
}

</style>