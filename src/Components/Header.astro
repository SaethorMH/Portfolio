    </logo> -->
    
        <Logo theme={theme} height="4rem"/>
        <h2>{heading}</h2>
   
    
    <nav>
        <a href="/">Frontpage</a>
        <a href="/Works">Works</a>
        <a href="/Contact">Contact</a>
    </nav>
</header>
<warning>
    <p>Website is Still in Development - Some Features and Content may be Missing</p>
</warning>



<style define:vars={{theme:`var(--${theme})`}}>
    warning{
        border: var(--yellow) 0.5rem dashed;
        background-color: var(--orange);
        text-align: center;
        font-weight: 900;
    }



    header{
        position: sticky;
        border: 0.2rem var(--theme) solid;
        height:5rem;
        display: flex;
        flex-direction: row;
        color: var(--textColor);
        background-color: var(--bgColor);
        align-items: center;
        justify-content: space-between;
        margin: 0 5rem;
    }
    
    div{
        display: flex;
    }

    nav{
        display: flex;
        gap: 1vw;
        margin-right: 2rem;
    }
    a{
        background-color: var(--theme);
        text-decoration: none;
        border: 0.2rem solid var(--theme);
        color: var(--textColor);
        padding: 0.5rem;
        width: 8rem;
        text-align: center;
        font-weight: 800;
        transition: 0.2s all ease-in-out;
    }
    
    a:hover{
        background-color: var(--bgColor);
        scale: 1.01;
    }
</style>