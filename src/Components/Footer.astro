---
import  Logo  from "./Logo.astro";
const { theme } = Astro.props;
---
<footer>
    <div class="flex">
<p>smhdesign.dk</p><p>Sæþór M. Hjálmarsson</p><p>© 2026</p>
</div>
<div class="grid">
    <div class="contact">
        <p>Here are some ways to reach me:</p>
    <ul>
      <li>
        <a href=https://www.linkedin.com/in/saethormh/" target="_blank"
          >LinkedIn</a
        >
      </li>
      <li>
        <a href="https://github.com/SaethorMH" target="_blank"
          >Github</a
        >
      </li>

      <li>Phone number: (+45)41592872</li>
      <li>Email: contact@smhdesign.dk</li>
    </ul>
    </div>
<div>
    <Logo theme={theme} height="8rem"/>
</div>


<div class="ai">
<h4>Use of A.I. notice:</h4>
<p>
This site does not use images or text generated by Artificial Intelligence. <br>
AI has has been used as a tool in the process of coding the website.<br>
When used, limited to troubleshooting, optimisations and research.<br>
No vibecode or Pasted sections.</p>

</div>
</div>

</footer>


<style define:vars={{theme:`var(--${theme})`}}>
footer{
    border: var(--theme) 0.2rem solid;
    place-self: center end;
    width: 85%;
    min-height: 50px;
    background-color: var(--bgColor);
    color: var(--textColor);
    }

.flex{
    border-bottom: 0.2rem solid var(--theme);
    place-self: center;
    width: 100%;
    display: flex;
    background-color: var(--bgColor);
    justify-content: space-evenly;
    align-items: center;
    gap: 0.2rem;
    background-color: var(--theme);
    
}
.flex>p{
    font-size: 1.5rem;
    width: 100%;
    text-align: center;
    background-color: var(--bgColor);
    max-width: none;
}
.grid{
    display: grid;
    gap: 0.2rem;
    grid-template-columns: 1fr auto 1fr;
    > *{
        place-self: center;
    }
    background-color: var(--theme);
}
.contact p{
    font-size: 1rem;
    font-weight: 500
}
.grid div{
    place-items: center;
margin: auto; 
   background-color: var(--bgColor);
    width: 100%;
    min-width: 20rem;
    height: 100%;
}
.grid div svg{
    display: block;
}
p{
    padding: 1rem 0px;
    font-size: 0.4rem;
    line-height: 0.8rem;
    background-color: var(--bgColor);
    max-width: 35ch;
}
ul{
    list-style:none;
}
li{
    font-size: 0.4;
}

